
function validationLineChart(targetId,points,valueKey,targetValue){
  const host=document.getElementById(targetId);
  const rows=(points||[]).filter(x=>Number.isFinite(Number(x[valueKey])));
  if(!rows.length){
    host.innerHTML="<div class='note'>No historical data yet.</div>";
    return;
  }
  const w=640,h=220,pad=34;
  const vals=rows.map(x=>Number(x[valueKey]));
  const maxV=Math.max(targetValue||0,...vals,1);
  const minV=Math.min(0,...vals);
  const span=Math.max(1,maxV-minV);
  const x=i=>pad+(rows.length===1?(w-2*pad)/2:i*(w-2*pad)/(rows.length-1));
  const y=v=>h-pad-((v-minV)/span)*(h-2*pad);
  const pts=rows.map((r,i)=>`${x(i)},${y(Number(r[valueKey]))}`).join(" ");
  const targetY=targetValue!=null?y(targetValue):null;

  let dots=rows.map((r,i)=>`
    <circle cx="${x(i)}" cy="${y(Number(r[valueKey]))}" r="4"></circle>
    <text x="${x(i)}" y="${h-10}" text-anchor="middle" font-size="10">${String(r.date||"").slice(5)}</text>
    <text x="${x(i)}" y="${Math.max(12,y(Number(r[valueKey]))-8)}" text-anchor="middle" font-size="10">${r[valueKey]}</text>
  `).join("");

  let targetLine=targetY==null?"":`
    <line x1="${pad}" y1="${targetY}" x2="${w-pad}" y2="${targetY}" stroke-dasharray="5,5"></line>
    <text x="${w-pad}" y="${Math.max(12,targetY-5)}" text-anchor="end" font-size="10">Target ${targetValue}</text>
  `;

  host.innerHTML=`
    <svg viewBox="0 0 ${w} ${h}" width="100%" height="220" role="img">
      <line x1="${pad}" y1="${h-pad}" x2="${w-pad}" y2="${h-pad}"></line>
      <line x1="${pad}" y1="${pad}" x2="${pad}" y2="${h-pad}"></line>
      ${targetLine}
      <polyline fill="none" stroke-width="2" points="${pts}"></polyline>
      ${dots}
    </svg>`;
}

const j=v=>JSON.stringify(v,null,2);
function showTab(n){for(const x of ["dashboard","ai","strategy","paper","operations","qualification","live","backtest","etrade","validationlab"])document.getElementById(x+"Tab").style.display=x===n?"block":"none";if(n==="ai")loadAI();if(n==="strategy")loadStrategy();if(n==="paper")loadPaper();if(n==="operations")loadOperations();if(n==="qualification")loadQualification();if(n==="live")loadLiveApproval();if(n==="backtest")loadBacktest();if(n==="etrade")loadEtrade();if(n==="validationlab")loadValidationLab()}
function metric(l,v,c=""){return `<div class="card"><div class="label">${l}</div><div class="value ${c}">${v}</div></div>`}
function table(el,rows){if(!rows||!rows.length){el.innerHTML="<tr><td>No data</td></tr>";return}const keys=Object.keys(rows[0]);el.innerHTML=`<tr>${keys.map(k=>`<th>${k}</th>`).join("")}</tr>`+rows.map(r=>`<tr>${keys.map(k=>`<td>${r[k]??""}</td>`).join("")}</tr>`).join("")}
async function getDashboard(){return fetch("/api/dashboard").then(r=>r.json())}

async function loadCommandCenter(){
  const d=await getDashboard();
  let q={};
  let o={};
  try{q=await fetch("/api/qualification",{cache:"no-store"}).then(r=>r.json())}catch(e){}
  try{o=await fetch("/api/operations-manager",{cache:"no-store"}).then(r=>r.json())}catch(e){}
  const ai=d.ai||{};
  const stop=!!d.emergency_stop?.enabled;
  const riskPass=!!d.risk?.gate?.passed;
  const market=(d.market_open===true?"OPEN":"CLOSED");
  const validationPassed=!!q.qualification?.passed;
  commandMetrics.innerHTML=[
    metric("System",stop?"STOPPED":"READY",stop?"warn":"ok"),
    metric("Market",market),
    metric("Paper Equity",d.paper_account?.equity??"N/A"),
    metric("Risk",riskPass?"PASS":"BLOCKED",riskPass?"ok":"warn"),
    metric("AI Health",ai.model_health??"N/A",ai.model_health==="GREEN"?"ok":ai.model_health==="RED"?"warn":""),
    metric("Validation",validationPassed?"PASS":"COLLECTING",validationPassed?"ok":""),
    metric("Live Orders",d.safety?.actual_live_orders_submitted??0,"ok")
  ].join("");
  commandToday.textContent=j({
    market,
    equity:d.paper_account?.equity,
    cash:d.paper_account?.cash,
    buying_power:d.paper_account?.buying_power,
    positions:(d.paper_positions||[]).length,
    open_orders:(d.paper_orders||[]).filter(x=>!["filled","canceled","cancelled","rejected"].includes(String(x.status||"").toLowerCase())).length,
    last_cycle:d.orchestrator?.cycle_id,
    paper_orders_submitted:d.orchestrator?.paper_orders_submitted??0
  });
  commandAI.textContent=j({
    model_health:ai.model_health,
    research_action:ai.research_action,
    best_horizon:ai.best_shadow_research_horizon,
    resolved_outcomes:ai.resolved_outcomes,
    waiting_future_marks:ai.waiting_future_marks,
    drift_status:ai.drift_status,
    research_comparison_allowed:ai.research_comparison_allowed
  });
  commandValidation.textContent=j({
    state:q.state,
    passed:validationPassed,
    metrics:q.metrics,
    qualification:q.qualification
  });
  commandSafety.textContent=j({
    emergency_stop:d.emergency_stop,
    risk_gate:d.risk?.gate,
    local_bind_only:d.safety?.local_bind_only,
    live_network_enabled:d.safety?.live_network_enabled,
    live_submission_enabled:d.safety?.live_submission_enabled,
    scheduled_paper_submission_enabled:o.safety?.scheduled_paper_order_submission_enabled,
    actual_live_orders_submitted:d.safety?.actual_live_orders_submitted??0
  });
  let msg=[];
  if(stop)msg.push("Emergency Stop is ON.");
  if(!riskPass)msg.push("Risk gate is currently blocked.");
  if(ai.model_health==="YELLOW")msg.push("AI validation is still accumulating; keep execution settings unchanged.");
  if(!validationPassed)msg.push("Paper qualification is still collecting evidence.");
  if(!msg.length)msg.push("No blocking dashboard alerts.");
  commandMessage.textContent=msg.join(" ");
}
async function commandRefresh(){
  await refresh();
  await loadCommandCenter();
}

async function refresh(){const d=await getDashboard();statusBadge.textContent=d.emergency_stop?.enabled?"STOPPED":"READY";metrics.innerHTML=[metric("Release",d.release?.state),metric("Paper Equity",d.paper_account?.equity??"N/A"),metric("Market",d.market_open===true?"OPEN":"CLOSED"),metric("Risk",d.risk?.gate?.passed?"PASS":"BLOCKED"),metric("AI Health",d.ai?.model_health??"N/A"),metric("Live Orders",0,"ok")].join("");account.textContent=j(d.paper_account);risk.textContent=j(d.risk);cycle.textContent=j(d.orchestrator);stop.textContent=j(d.emergency_stop);table(positions,d.paper_positions);table(orders,d.paper_orders);logs.textContent=j(await fetch("/api/logs").then(r=>r.json()))}
async function loadAI(){const d=await getDashboard();const a=d.ai||{};aiMetrics.innerHTML=[metric("Health",a.model_health??"N/A",a.model_health==="GREEN"?"ok":a.model_health==="RED"?"warn":""),metric("Action",a.research_action??"WAIT"),metric("Best Horizon",a.best_shadow_research_horizon??"N/A"),metric("Symbols",a.inference_symbol_count??0),metric("Resolved",a.resolved_outcomes??0),metric("Waiting",a.waiting_future_marks??0),metric("Drift",a.drift_status??"N/A"),metric("High Uncertainty",a.high_uncertainty_symbols??0)].join("");aiHealth.textContent=j({model_health:a.model_health,research_action:a.research_action,research_comparison_allowed:a.research_comparison_allowed,automatic_execution_change:a.automatic_execution_change,automatic_model_promotion:a.automatic_model_promotion});aiValidation.textContent=j({best_shadow_research_horizon:a.best_shadow_research_horizon,resolved_outcomes:a.resolved_outcomes,waiting_future_marks:a.waiting_future_marks,research_ready_horizons:a.research_ready_horizons,regime_outcomes:a.regime_outcomes,regime_interpretation_ready:a.regime_interpretation_ready});aiDrift.textContent=j({calibration_ready:a.calibration_ready,drift_status:a.drift_status,high_drift_features:a.high_drift_features,medium_drift_features:a.medium_drift_features});aiConsensus.textContent=j({consensus_symbol_count:a.consensus_symbol_count,high_uncertainty_symbols:a.high_uncertainty_symbols});aiDetails.textContent=j(a.details)}
async function runAction(name){const r=await fetch("/api/action",{method:"POST",headers:{"Content-Type":"application/json"},body:j({name})});actionResult.textContent=j(await r.json());refresh()}
async function setStop(enabled){const d=await fetch("/api/emergency-stop",{method:"POST",headers:{"Content-Type":"application/json"},body:j({enabled,reason:"WEB"})}).then(r=>r.json());actionResult.textContent=j(d);refresh()}

let strategyLoaded=null;
function strategyPayloadFromForm(){
  const current=(strategyLoaded?.config)||{};
  const existingStrategies=current.strategies||{};
  return {
    strategies:{
      momentum:{enabled:strategyMomentum.checked,weight_pct:Number(existingStrategies.momentum?.weight_pct??50)},
      mean_reversion:{enabled:strategyMeanReversion.checked,weight_pct:Number(existingStrategies.mean_reversion?.weight_pct??25)},
      breakout:{enabled:strategyBreakout.checked,weight_pct:Number(existingStrategies.breakout?.weight_pct??25)}
    },
    symbols:strategySymbols.value.split(",").map(x=>x.trim().toUpperCase()).filter(Boolean),
    risk:{
      maximum_order_notional:Number(riskOrderNotional.value),
      maximum_quantity:Number(riskMaxQty.value),
      maximum_daily_orders:Number(riskDailyOrders.value),
      maximum_daily_loss:Number(riskDailyLoss.value),
      maximum_positions:Number(riskMaxPositions.value)
    },
    paper_only:true,
    live_submission_enabled:false
  };
}
function fillStrategyForm(cfg){
  cfg=cfg||{};
  const s=cfg.strategies||{}, r=cfg.risk||{};
  strategyMomentum.checked=!!s.momentum?.enabled;
  strategyMeanReversion.checked=!!s.mean_reversion?.enabled;
  strategyBreakout.checked=!!s.breakout?.enabled;
  strategySymbols.value=(cfg.symbols||[]).join(",");
  riskOrderNotional.value=r.maximum_order_notional??250;
  riskMaxQty.value=r.maximum_quantity??1;
  riskDailyOrders.value=r.maximum_daily_orders??3;
  riskDailyLoss.value=r.maximum_daily_loss??50;
  riskMaxPositions.value=r.maximum_positions??3;
}
async function loadStrategy(){
  const d=await fetch("/api/strategy-config",{cache:"no-store"}).then(r=>r.json());
  strategyLoaded=d;
  fillStrategyForm(d.config);
  strategyCurrentConfig.textContent=j(d.config);
  strategyRuntimePolicy.textContent=j(d.runtime_policy);
  const ai=(await getDashboard()).ai||{};
  strategyMetrics.innerHTML=[
    metric("Mode",d.config?.paper_only?"PAPER ONLY":"UNKNOWN",d.config?.paper_only?"ok":"warn"),
    metric("Live Submission",d.config?.live_submission_enabled?"ENABLED":"DISABLED",d.config?.live_submission_enabled?"warn":"ok"),
    metric("Emergency Stop",d.emergency_stop?.enabled?"ON":"OFF",d.emergency_stop?.enabled?"warn":"ok"),
    metric("AI Health",ai.model_health??"N/A"),
    metric("AI Research",ai.research_comparison_allowed?"READY":"WAIT")
  ].join("");
  strategyAiRecommendation.textContent=j({
    model_health:ai.model_health,
    research_action:ai.research_action,
    best_shadow_research_horizon:ai.best_shadow_research_horizon,
    research_comparison_allowed:ai.research_comparison_allowed,
    note:ai.research_comparison_allowed
      ?"AI evidence is ready for manual research comparison. No automatic strategy change is performed."
      :"Validation evidence is still accumulating. Keep current execution settings unchanged."
  });
}
async function validateStrategy(){
  const payload=strategyPayloadFromForm();
  const r=await fetch("/api/strategy-config/validate",{
    method:"POST",headers:{"Content-Type":"application/json"},body:j(payload)
  }).then(r=>r.json());
  strategyActionResult.textContent=j(r);
}
async function saveStrategy(){
  const payload=strategyPayloadFromForm();
  const r=await fetch("/api/strategy-config/save",{
    method:"POST",headers:{"Content-Type":"application/json"},body:j(payload)
  }).then(r=>r.json());
  strategyActionResult.textContent=j(r);
  if(r.ok)await loadStrategy();
}
async function restoreStrategy(){
  const r=await fetch("/api/strategy-config/restore",{method:"POST"}).then(r=>r.json());
  strategyActionResult.textContent=j(r);
  if(r.ok)await loadStrategy();
}


async function loadBacktest(){
  const d=await fetch("/api/backtest",{cache:"no-store"}).then(r=>r.json());
  const a=d.automated||{}, ag=a.aggregation||{}, c=d.canonical||{}, q=d.quality||{};
  const opts=d.options||{}, selected=d.latest_selected||{};
  backtestMetrics.innerHTML=[
    metric("State",a.automated_backtest_state??"NOT_AVAILABLE"),
    metric("Strategies",a.strategy_count??0),
    metric("Datasets",a.dataset_count??0),
    metric("Jobs",a.job_count??0),
    metric("Completed",ag.completed_count??0),
    metric("Canonical Trades",c.canonical_trade_count??0),
    metric("Curated Trades",q.curated_record_count??0),
    metric("Live Orders",0,"ok")
  ].join("");
  backtestAutomated.textContent=j(a);
  backtestCanonical.textContent=j(c);
  backtestQuality.textContent=j(q);
  backtestTop.textContent=j(ag.top_result||null);
  table(backtestRankings,(ag.rankings||[]).slice(0,20));
  backtestSafety.textContent=j(d.safety);
  const fill=(el,rows,idKey,labelFn)=>{
    const current=el.value;
    el.innerHTML=(rows||[]).map(x=>`<option value="${x[idKey]}">${labelFn(x)}</option>`).join("");
    if([...el.options].some(o=>o.value===current))el.value=current;
  };
  fill(btStrategy,opts.strategies,"strategy_id",x=>`${x.strategy_id} (${x.family})`);
  fill(btDataset,opts.datasets,"dataset_id",x=>`${x.dataset_id} - ${x.symbol}`);
  fill(btWindow,opts.windows,"window_id",x=>`${x.window_id} [${x.start_index}:${x.end_index}]`);
  backtestSelectedResult.textContent=j(selected);
  const cmp=d.comparison||{};
  comparisonMetrics.innerHTML=[
    metric("Decision",cmp.recommendation?.decision??"WAIT"),
    metric("AI Health",cmp.ai?.model_health??"N/A"),
    metric("AI Ready",cmp.ai?.research_comparison_allowed?"YES":"NO"),
    metric("Candidate",cmp.candidate?.available?"AVAILABLE":"NONE"),
    metric("Auto Apply","OFF","ok")
  ].join("");
  comparisonCurrent.textContent=j(cmp.current_strategy);
  comparisonCandidate.textContent=j(cmp.candidate);
  comparisonAI.textContent=j(cmp.ai);
  comparisonRecommendation.textContent=j(cmp.recommendation);
}
async function runSelectedBacktest(){
  const payload={
    action:"run_selected",
    strategy_id:btStrategy.value,
    dataset_id:btDataset.value,
    window_id:btWindow.value,
    force:btForce.checked
  };
  const r=await fetch("/api/backtest/action",{
    method:"POST",headers:{"Content-Type":"application/json"},body:j(payload)
  }).then(r=>r.json());
  backtestActionResult.textContent=j(r);
  await loadBacktest();
}
async function backtestAction(action){
  const r=await fetch("/api/backtest/action",{
    method:"POST",headers:{"Content-Type":"application/json"},body:j({action})
  }).then(r=>r.json());
  backtestActionResult.textContent=j(r);
  await loadBacktest();
}


async function loadEtrade(){
  const d=await fetch("/api/etrade",{cache:"no-store"}).then(r=>r.json());
  etradeMetrics.innerHTML=[
    metric("V2 Read-Only",d.stack?.v2_readonly_present?"PRESENT":"MISSING",d.stack?.v2_readonly_present?"ok":"warn"),
    metric("V2.1.10 Bridge",d.stack?.v2_1_10_present?"PRESENT":"MISSING",d.stack?.v2_1_10_present?"ok":"warn"),
    metric("V2.1.31.4 Audit",d.audit?.installed?"INSTALLED":"MISSING",d.audit?.installed?"ok":"warn"),
    metric("Credentials",d.credentials?.consumer_key_present&&d.credentials?.consumer_secret_present?"PRESENT":"NOT SET"),
    metric("Prod POST",d.safety?.production_order_post_allowed?"ENABLED":"LOCKED",d.safety?.production_order_post_allowed?"warn":"ok"),
    metric("Live Trading",d.safety?.live_trading_enabled?"ENABLED":"LOCKED",d.safety?.live_trading_enabled?"warn":"ok")
  ].join("");
  etradeStack.textContent=j(d.stack);
  etradeCredentials.textContent=j(d.credentials);
  etradeAudit.textContent=j(d.audit);
  etradeSafety.textContent=j(d.safety);
  table(etradeArtifacts,d.recent_artifacts||[]);
}
async function etradeAction(action){
  const r=await fetch("/api/etrade/action",{
    method:"POST",headers:{"Content-Type":"application/json"},body:j({action})
  }).then(r=>r.json());
  etradeActionResult.textContent=j(r);
  await loadEtrade();
}


async function loadValidationLab(){
  const d=await fetch("/api/validation-lab",{cache:"no-store"}).then(r=>r.json());
  const c=d.collector||{}, sc=d.scorecard||{}, ml=d.ml||{}, p=d.paper||{};
  validationLabMetrics.innerHTML=[
    metric("Collector Cycles",c.cycles_completed??0),
    metric("Actual Outcomes",sc.champion_actual?.completed_outcomes??ml.total_resolved_outcomes??0),
    metric("Shadow Completed",sc.challenger_shadow?.completed_counterfactual_round_trips??0),
    metric("ML Ready",ml.research_comparison_ready?"YES":"NO",ml.research_comparison_ready?"ok":""),
    metric("AI Health",ml.model_health??"N/A"),
    metric("Paper Qualified",p.passed?"YES":"NO",p.passed?"ok":""),
    metric("Live Orders",0,"ok")
  ].join("");
  validationLabCollector.textContent=j(c);
  validationLabScorecard.textContent=j(sc);
  validationLabML.textContent=j(ml);
  validationLabPaper.textContent=j(p);
  validationLabBlocks.textContent=j(d.blockers);
  validationLabSafety.textContent=j(d.safety);
  const pr=d.progress||{};
  validationProgressMetrics.innerHTML=[
    metric("Trading Days",`${pr.trading_days_completed??0}/${pr.trading_days_target??10}`),
    metric("Day Progress",`${pr.trading_day_progress_pct??0}%`),
    metric("Resolved",`${pr.resolved_outcomes??0}/${pr.resolved_outcomes_target??200}`),
    metric("Sample Progress",`${pr.resolved_progress_pct??0}%`),
    metric("AI Health",pr.ai_health??"N/A"),
    metric("Paper Qualified",pr.paper_qualified?"YES":"NO",pr.paper_qualified?"ok":"")
  ].join("");
  validationProgressDays.textContent=j({
    observed_dates:pr.observed_validation_dates,
    completed:pr.trading_days_completed,
    target:pr.trading_days_target,
    remaining:pr.trading_days_remaining,
    progress_pct:pr.trading_day_progress_pct
  });
  validationProgressSamples.textContent=j({
    resolved_outcomes:pr.resolved_outcomes,
    target:pr.resolved_outcomes_target,
    remaining:pr.resolved_outcomes_remaining,
    waiting_for_future_marks:pr.waiting_for_future_marks,
    progress_pct:pr.resolved_progress_pct
  });
  validationProgressGates.textContent=j(pr.gates);
  validationProgressNext.textContent=j({
    next_milestone:pr.next_milestone,
    blockers:pr.blockers
  });
  const sch=d.scheduler||{}, hist=d.history||{};
  validationSchedulerMetrics.innerHTML=[
    metric("Scheduler",sch.running?"RUNNING":"STOPPED",sch.running?"ok":""),
    metric("Morning",sch.config?.morning_time??"07:30"),
    metric("Post-Market",sch.config?.post_market_time??"13:20"),
    metric("History Days",hist.day_count??0),
    metric("Last Run",sch.last_run?.phase??"NONE"),
    metric("Orders",0,"ok")
  ].join("");
  validationSchedulerStatus.textContent=j(sch);
  validationLatestHistory.textContent=j(hist.latest||{});
  table(validationHistoryTable,hist.recent||[]);

  const rep=d.report||{}, points=rep.points||[];
  validationReportMetrics.innerHTML=[
    metric("History Days",rep.history_days??0),
    metric("Validation Days",`${rep.validation_days_completed??0}/${rep.validation_days_target??10}`),
    metric("Resolved",`${rep.latest_resolved_outcomes??0}/${rep.resolved_outcomes_target??200}`),
    metric("Resolved Δ",rep.resolved_delta??0),
    metric("Waiting",rep.latest_waiting_future_marks??0),
    metric("AI Health",rep.latest_ai_health??"N/A")
  ].join("");

  validationLineChart("validationResolvedChart",points,"resolved_outcomes",rep.resolved_outcomes_target??200);
  validationLineChart("validationWaitingChart",points,"waiting_for_future_marks",null);

  validationReadinessTimeline.textContent=j(rep.readiness_timeline||[]);
  validationReportSummary.textContent=j({
    first_date:rep.first_date,
    latest_date:rep.latest_date,
    history_days:rep.history_days,
    validation_days_completed:rep.validation_days_completed,
    validation_days_remaining:rep.validation_days_remaining,
    latest_resolved_outcomes:rep.latest_resolved_outcomes,
    resolved_outcomes_remaining:rep.resolved_outcomes_remaining,
    resolved_delta:rep.resolved_delta,
    latest_waiting_future_marks:rep.latest_waiting_future_marks,
    waiting_delta:rep.waiting_delta,
    latest_ai_health:rep.latest_ai_health,
    latest_paper_qualified:rep.latest_paper_qualified,
    latest_research_comparison_ready:rep.latest_research_comparison_ready,
    next_milestone:rep.next_milestone
  });
  table(validationReportTable,points);
}
